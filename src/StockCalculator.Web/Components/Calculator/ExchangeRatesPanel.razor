<div class="card mb-4">
    <div class="card-body py-2">
        <div class="fw-semibold mb-1">Średnie kursy NBP</div>
        <dl class="row mb-0">
            @foreach (var currency in Enum.GetValues<CurrencyCode>())
            {
                <dt class="col-3 col-sm-2 mb-0">@currency</dt>
                <dd class="col-9 col-sm-10 mb-0">@FormatRate(currency)</dd>
            }
        </dl>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ExchangeRatesSnapshot Rates { get; set; } = default!;

    private string FormatRate(CurrencyCode currency) =>
        Rates.Find(currency) is { } rate
            ? $"{NumberFormatter.ExchangeRate(rate.AverageRateInPln)} zł (z dnia {NumberFormatter.Date(rate.EffectiveDate)})"
            : "brak kursu";
}
