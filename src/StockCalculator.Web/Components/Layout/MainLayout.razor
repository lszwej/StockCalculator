@inherits LayoutComponentBase

<header class="navbar border-bottom bg-body-tertiary">
    <div class="container">
        <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Motyw">
            <button type="button" class="btn btn-outline-secondary theme-toggle" data-theme-value="light"
                    aria-pressed="false" aria-label="Tryb jasny" title="Tryb jasny">
                <svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"
                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <circle cx="8" cy="8" r="3" fill="currentColor" />
                    <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
                </svg>
            </button>
            <button type="button" class="btn btn-outline-secondary theme-toggle" data-theme-value="dark"
                    aria-pressed="false" aria-label="Tryb ciemny" title="Tryb ciemny">
                <svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor">
                    <path d="M14 10.2A6.5 6.5 0 0 1 5.8 2a6.5 6.5 0 1 0 8.2 8.2Z" />
                </svg>
            </button>
        </div>
    </div>
</header>

<main class="container py-4">
    @Body
</main>

<div id="blazor-error-ui" class="alert alert-danger m-0 rounded-0" role="alert" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="alert-link reload">Odśwież</a>
    <span class="dismiss" role="button" aria-label="Zamknij">✕</span>
</div>
